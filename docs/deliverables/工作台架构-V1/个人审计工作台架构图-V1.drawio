<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="24.7.17" type="device">
  <diagram id="page-1" name="00 使用说明">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cover" value="&lt;b&gt;个人审计工作台架构｜V1&lt;/b&gt;&lt;br&gt;&lt;br&gt;144 个节点，24 项审计事项，8 类台账登记，19 条参考流程映射。所有节点与连接线可编辑；编号对应 Excel。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EAF5F0;strokeColor=#CADBD4;fontColor=#203A35;fontSize=28;" vertex="1" parent="1">
          <mxGeometry x="70" y="80" width="1450" height="260" as="geometry" />
        </mxCell>
        <mxCell id="readme" value="&lt;b&gt;如何调整&lt;/b&gt;&lt;br&gt;&lt;br&gt;双击修改文字；拖动节点调整布局；拖动连线调整关系。建议在 Excel 同步记录调整后的名称、上级编号、处理方式与意见。三个文件不会自动互相同步，也不会改变线上平台。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFF2DB;strokeColor=#CADBD4;fontColor=#203A35;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="70" y="410" width="1450" height="250" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-full" name="全量架构树｜全部节点可编辑">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2350" pageHeight="22835" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tree-ROOT" value="&lt;b&gt;ROOT｜openAudit 个人审计工作台&lt;/b&gt;&lt;br&gt;&lt;br&gt;以审计人员个人办理为入口，围绕项目共享资料完成核查、文书编制、复核审理、整改检查和归档；保留来源与办理记录。&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#58716B&quot;&gt;部分实现&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#CADBD4;fontColor=#203A35;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="65" y="11442.5" width="490" height="155" as="geometry" />
        </mxCell>
        <mxCell id="tree-P" value="&lt;b&gt;P｜我的工作台&lt;/b&gt;&lt;br&gt;&lt;br&gt;根据个人岗位推荐事项，收藏常用功能、记录个人安排，并查看项目共用的待核事项和最近结果。&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#58716B&quot;&gt;已实现&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EAF5F0;strokeColor=#CADBD4;fontColor=#203A35;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="625" y="1175.0" width="490" height="155" as="geometry" />
        </mxCell>
        <mxCell id="tree-edge-P" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#89AAA0;fontSize=13;endArrow=block;" edge="1" parent="1" source="tree-ROOT" target="tree-P">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tree-M" value="&lt;b&gt;M｜审计资料&lt;/b&gt;&lt;br&gt;&lt;br&gt;接收、查找和核对审计资料，管理版本、摘录、原件阅读与个人关注。&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#58716B&quot;&gt;已实现&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EAF5F0;strokeColor=#CADBD4;fontColor=#203A35;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="625" y="3395.0" width="490" height="155" as="geometry" />
        </mxCell>
        <mxCell id="tree-edge-M" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#89AAA0;fontSize=13;endArrow=block;" edge="1" parent="1" source="tree-ROOT" target="tree-M">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tree-FA" value="&lt;b&gt;FA｜事实核对&lt;/b&gt;&lt;br&gt;&lt;br&gt;对资料提取或人工录入的事实明细进行核验、校正和确认，并追溯原件出处。&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#58716B&quot;&gt;已实现&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EAF5F0;strokeColor=#CADBD4;fontColor=#203A35;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="625" y="5152.5" width="490" height="155" as="geometry" />
        </mxCell>
        <mxCell id="tree-edge-FA" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#89AAA0;fontSize=13;endArrow=block;" edge="1" parent="1" source="tree-ROOT" target="tree-FA">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tree-ST" value="&lt;b&gt;ST｜按审计阶段查找&lt;/b&gt;&lt;br&gt;&lt;br&gt;按六个阶段组织 24 项办理事项，支持跨阶段查找、收藏和按个人分工进入。&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#58716B&quot;&gt;已实现&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EAF5F0;strokeColor=#CADBD4;fontColor=#203A35;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="625" y="7650.0" width="490" height="155" as="geometry" />
        </mxCell>
        <mxCell id="tree-edge-ST" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#89AAA0;fontSize=13;endArrow=block;" edge="1" parent="1" source="tree-ROOT" target="tree-ST">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tree-W" value="&lt;b&gt;W｜文书办理台账&lt;/b&gt;&lt;br&gt;&lt;br&gt;登记实际发生的单位、节点、回证、质量控制、签发用印、修改留痕和归档移交。&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#58716B&quot;&gt;已实现&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EAF5F0;strokeColor=#CADBD4;fontColor=#203A35;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="625" y="11720.0" width="490" height="155" as="geometry" />
        </mxCell>
        <mxCell id="tree-edge-W" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#89AAA0;fontSize=13;endArrow=block;" edge="1" parent="1" source="tree-ROOT" target="tree-W">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tree-R" value="&lt;b&gt;R｜项目待核事项&lt;/b&gt;&lt;br&gt;&lt;br&gt;汇集核查线索、处理意见、变更影响和人工确认历史，供人员按分工核验。&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#58716B&quot;&gt;已实现&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EAF5F0;strokeColor=#CADBD4;fontColor=#203A35;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="625" y="15512.5" width="490" height="155" as="geometry" />
        </mxCell>
        <mxCell id="tree-edge-R" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#89AAA0;fontSize=13;endArrow=block;" edge="1" parent="1" source="tree-ROOT" target="tree-R">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tree-L" value="&lt;b&gt;L｜审计参考资料&lt;/b&gt;&lt;br&gt;&lt;br&gt;管理可复用的案例、审计方法和参考数据，保留适用范围、审核及测试要求。&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#58716B&quot;&gt;已实现&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EAF5F0;strokeColor=#CADBD4;fontColor=#203A35;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="625" y="16437.5" width="490" height="155" as="geometry" />
        </mxCell>
        <mxCell id="tree-edge-L" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#89AAA0;fontSize=13;endArrow=block;" edge="1" parent="1" source="tree-ROOT" target="tree-L">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tree-H" value="&lt;b&gt;H｜办理记录&lt;/b&gt;&lt;br&gt;&lt;br&gt;查看办理过程、成功或失败情况及操作留痕，追踪结果形成过程。&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#58716B&quot;&gt;已实现&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EAF5F0;strokeColor=#CADBD4;fontColor=#203A35;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="625" y="17177.5" width="490" height="155" as="geometry" />
        </mxCell>
        <mxCell id="tree-edge-H" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#89AAA0;fontSize=13;endArrow=block;" edge="1" parent="1" source="tree-ROOT" target="tree-H">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tree-SET" value="&lt;b&gt;SET｜演示资料管理&lt;/b&gt;&lt;br&gt;&lt;br&gt;分批导入模拟资料或重置模拟项目，支持演示和验证。&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#58716B&quot;&gt;已实现&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EAF5F0;strokeColor=#CADBD4;fontColor=#203A35;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="625" y="17547.5" width="490" height="155" as="geometry" />
        </mxCell>
        <mxCell id="tree-edge-SET" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#89AAA0;fontSize=13;endArrow=block;" edge="1" parent="1" source="tree-ROOT" target="tree-SET">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tree-U" value="&lt;b&gt;U｜各事项共用的办理能力&lt;/b&gt;&lt;br&gt;&lt;br&gt;统一选择资料、引用成果、执行核查、核验结果、导出文书及比较版本。&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#58716B&quot;&gt;已实现&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#CADBD4;fontColor=#203A35;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="625" y="18657.5" width="490" height="155" as="geometry" />
        </mxCell>
        <mxCell id="tree-edge-U" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#89AAA0;fontSize=13;endArrow=block;" edge="1" parent="1" source="tree-ROOT" target="tree-U">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tree-SYS" value="&lt;b&gt;SYS｜基础支撑与数据边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;支撑登录校验、资料持久化、来源引用、版本失效、模型调用和本机文件预览。&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#58716B&quot;&gt;已实现&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#CADBD4;fontColor=#203A35;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="625" y="20230.0" width="490" height="155" as="geometry" />
        </mxCell>
        <mxCell id="tree-edge-SYS" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#89AAA0;fontSize=13;endArrow=block;" edge="1" parent="1" source="tree-ROOT" target="tree-SYS">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tree-NEXT" value="&lt;b&gt;NEXT｜个人工作台待完善项&lt;/b&gt;&lt;br&gt;&lt;br&gt;列出实现正式个人工作台仍需明确的账号、项目、任务、权限与协同能力，供本轮调整。&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#58716B&quot;&gt;待规划&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFF2DB;strokeColor=#CADBD4;fontColor=#203A35;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="625" y="21710.0" width="490" height="155" as="geometry" />
        </mxCell>
        <mxCell id="tree-edge-NEXT" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#89AAA0;fontSize=13;endArrow=block;" edge="1" parent="1" source="tree-ROOT" target="tree-NEXT">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tree-P01" value="&lt;b&gt;P01｜我的工作岗位&lt;/b&gt;&lt;br&gt;&lt;br&gt;选择工作岗位，改变首页推荐事项；所有阶段仍可访问。&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#58716B&quot;&gt;已实现&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#CADBD4;fontColor=#203A35;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1185" y="435.0" width="490" height="155" as="geometry" />
        </mxCell>
        <mxCell id="tree-edge-P01" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#89AAA0;fontSize=13;endArrow=block;" edge="1" parent="1" source="tree-P" target="tree-P01">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tree-P02" value="&lt;b&gt;P02｜我常用的事项&lt;/b&gt;&lt;br&gt;&lt;br&gt;收藏或取消收藏办理事项，在首页集中显示，减少逐级查找。&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#58716B&quot;&gt;已实现&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#CADBD4;fontColor=#203A35;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1185" y="990" width="490" height="155" as="geometry" />
        </mxCell>
        <mxCell id="tree-edge-P02" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#89AAA0;fontSize=13;endArrow=block;" edge="1" parent="1" source="tree-P" target="tree-P02">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tree-P03" value="&lt;b&gt;P03｜我的工作安排&lt;/b&gt;&lt;br&gt;&lt;br&gt;记录个人准备办理的工作，关联办理事项，可勾选完成、进入办理或移除。&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#58716B&quot;&gt;已实现&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#CADBD4;fontColor=#203A35;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1185" y="1175" width="490" height="155" as="geometry" />
        </mxCell>
        <mxCell id="tree-edge-P03" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#89AAA0;fontSize=13;endArrow=block;" edge="1" parent="1" source="tree-P" target="tree-P03">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tree-P04" value="&lt;b&gt;P04｜上手指引&lt;/b&gt;&lt;br&gt;&lt;br&gt;提供收集资料、核对原件与摘录、选择事项办理三个快捷入口。&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#58716B&quot;&gt;已实现&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#CADBD4;fontColor=#203A35;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1185" y="1360" width="490" height="155" as="geometry" />
        </mxCell>
        <mxCell id="tree-edge-P04" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#89AAA0;fontSize=13;endArrow=block;" edge="1" parent="1" source="tree-P" target="tree-P04">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tree-P05" value="&lt;b&gt;P05｜按阶段与关键词找事项&lt;/b&gt;&lt;br&gt;&lt;br&gt;按阶段或合同、底稿等工作关键词查找功能，不要求按顺序执行全部事项。&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#58716B&quot;&gt;已实现&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#CADBD4;fontColor=#203A35;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1185" y="1545" width="490" height="155" as="geometry" />
        </mxCell>
        <mxCell id="tree-edge-P05" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#89AAA0;fontSize=13;endArrow=block;" edge="1" parent="1" source="tree-P" target="tree-P05">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tree-P06" value="&lt;b&gt;P06｜项目待核提醒&lt;/b&gt;&lt;br&gt;&lt;br&gt;折叠展示项目共用待核内容，提示进入项目待核事项核验处理。&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#58716B&quot;&gt;已实现&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#CADBD4;fontColor=#203A35;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1185" y="1730" width="490" height="155" as="geometry" />
        </mxCell>
        <mxCell id="tree-edge-P06" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#89AAA0;fontSize=13;endArrow=block;" edge="1" parent="1" source="tree-P" target="tree-P06">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tree-P07" value="&lt;b&gt;P07｜项目最近办理结果&lt;/b&gt;&lt;br&gt;&lt;br&gt;查看项目最新成果及其状态，快速返回相关事项核对。&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#58716B&quot;&gt;已实现&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#CADBD4;fontColor=#203A35;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1185" y="1915" width="490" height="155" as="geometry" />
        </mxCell>
        <mxCell id="tree-edge-P07" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#89AAA0;fontSize=13;endArrow=block;" edge="1" parent="1" source="tree-P" target="tree-P07">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tree-ROLE-member" value="&lt;b&gt;ROLE-member｜审计组成员&lt;/b&gt;&lt;br&gt;&lt;br&gt;为该岗位推荐 B05、B03、B09、B08，个人可收藏其他事项；不限制对全部功能的访问。&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#58716B&quot;&gt;已实现&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#CADBD4;fontColor=#203A35;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1745" y="65" width="490" height="155" as="geometry" />
        </mxCell>
        <mxCell id="tree-edge-ROLE-member" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#89AAA0;fontSize=13;endArrow=block;" edge="1" parent="1" source="tree-P01" target="tree-ROLE-member">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tree-ROLE-lead" value="&lt;b&gt;ROLE-lead｜审计组组长 / 主审&lt;/b&gt;&lt;br&gt;&lt;br&gt;为该岗位推荐 A03、C01、C02、D01，个人可收藏其他事项；不限制对全部功能的访问。&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#58716B&quot;&gt;已实现&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFFFFF;strokeColor=#CADBD4;fontColor=#203A35;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1745" y="250" width="490" height="155" as="geometry" />
        </mxCell>
        <mxCell id="tree-edge-ROLE-lead" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#89AAA0;fontSize=13;endArrow=block;" edge="1" parent="1" source="tree-P01" target="tree-ROLE-lead">
